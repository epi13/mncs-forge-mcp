# Disabled configuration fragment. Do not load without an explicit Provider Protocol
# adapter, reviewed capability claims, and project-specific absolute command/identity.

[[providers]]
id = "joern-legacy"
name = "Joern legacy Provider Protocol adapter"
identity = "replace-with-reviewed-adapter-identity"
version = "replace-with-reviewed-adapter-version"
command = ["/absolute/path/to/mncs-provider-joern-adapter"]
transport = "stdio-jsonl"
required = false
capabilities = [
  "control-flow",
  "control-dependencies",
  "call-graph",
  "data-flow"
]
supported_constructs = []
unsupported_constructs = []
limitations = [
  "Forge orchestrates this adapter and does not perform Joern-equivalent analysis",
  "actual language/frontend/query support must be declared by the adapter probe"
]

[[workflows]]
name = "joern-legacy-structural"
category = "bounded_structural_analysis"
mode = "development"
command = ["/absolute/path/to/mncs-provider-joern-adapter"]
provider_protocol = true
provider_id = "joern-legacy"
subject = "candidate"
disclosure = "compact"
