{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mncs-forge/resources/learned-specialist-shadow.schema.json",
  "title": "Forge learned specialist shadow observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "request_identity", "provider_id", "model_identity", "generation_identity", "calibration_identity", "source_record_identities", "selected_source_record_identities", "comparison", "measurements", "authority"],
  "properties": {
    "schema": {"const": "mncs-forge-learned-specialist-shadow/0.1"},
    "status": {"enum": ["OBSERVED", "UNKNOWN"]},
    "request_identity": {"$ref": "#/$defs/identity"},
    "provider_id": {"type": "string", "minLength": 1},
    "model_identity": {"$ref": "#/$defs/identity"},
    "generation_identity": {"$ref": "#/$defs/identity"},
    "calibration_identity": {"$ref": "#/$defs/identity"},
    "operating_envelope": {"type": "object"},
    "lineage_identity": {"anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]},
    "source_record_identities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_source_record_identities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_vs_generated": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "abstained": {"type": "boolean"},
    "abstention_count": {"type": "integer", "minimum": 0},
    "escalation_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "comparison": {"type": "object"},
    "measurements": {"type": "object"},
    "reproducibility": {"type": "object"},
    "semantics": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "authority": {"const": "diagnostic-only"}
  },
  "$defs": {"identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
