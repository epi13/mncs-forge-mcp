{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mncs-forge:schema:forge-cell-test-bundle-0.1",
  "title": "Forge Cell test bundle manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "bundle_id",
    "policy_id",
    "files",
    "harness",
    "expected_outputs",
    "custody",
    "signatures"
  ],
  "properties": {
    "record_type": {"const": "forge-cell-test-bundle"},
    "schema_version": {"const": "0.1"},
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "size", "role"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "digest": {"$ref": "#/$defs/sha256"},
          "size": {"type": "integer", "minimum": 0},
          "role": {"enum": ["test", "fixture", "harness", "policy", "metadata"]}
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "argv_prefix"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "digest": {"$ref": "#/$defs/sha256"},
        "argv_prefix": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "required": {"type": "boolean"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "holder"],
      "properties": {
        "classification": {
          "enum": ["local-operator", "same-operator-remote", "external-holder", "protected-holdout"]
        },
        "holder": {"type": "string", "minLength": 1, "maxLength": 256},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "key_id", "envelope_digest"],
        "properties": {
          "kind": {"enum": ["dsse-ed25519", "external-receipt"]},
          "key_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "envelope_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
